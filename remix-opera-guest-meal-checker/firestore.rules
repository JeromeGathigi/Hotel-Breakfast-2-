rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() { return request.auth != null && request.auth.token.staff == true; }
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }

    match /hotels/{hotelId} {
      match /guests/{guestId}          { allow read: if isStaff() || isAdmin(); allow write: if isAdmin(); }
      match /metadata/{docId}          { allow read: if isStaff() || isAdmin(); allow write: if isAdmin(); }
      match /overrides/{roomNumber}    { allow read: if isStaff() || isAdmin(); allow write: if isStaff() || isAdmin(); }
      match /history/{date}/guests/{g} { allow read: if isStaff() || isAdmin(); allow write: if false; }
      match /dailyStats/{date}         { allow read: if isStaff() || isAdmin(); allow write: if false; }
      match /checkins/{date}/rooms/{r} { allow read: if isStaff() || isAdmin(); allow write: if isStaff() || isAdmin(); }
    }
  }
}

# Firebase Client Configuration (Optional / Integration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# Firebase Admin, for scripts/ only. Generate the key yourself in the console and point this
# at it; never commit it. .gitignore blocks *service-account*.json and .env*.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIRESTORE_DATABASE_ID=

# scripts/importOpera.ts and scripts/watchOpera.ts. The hotel is read from each file; this is
# used only for a file that cannot say (no RESORT column). Must be novotel or ibis.
OPERA_HOTEL_ID=
OPERA_IMPORT_DIR=opera-incoming
OPERA_ARCHIVE_DIR=opera-processed
OPERA_REJECTED_DIR=opera-rejected
OPERA_POLL_INTERVAL_MS=10000
OPERA_SETTLE_MS=5000

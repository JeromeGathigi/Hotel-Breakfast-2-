{
  "name": "opera-sync-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for automated Opera PMS Excel & CSV manifest ingestion into Firestore",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
